+    if shuffle:
+        return DistributedSampler(dataset, num_replicas=get_world_size(), rank=get_rank(),
+                                  shuffle=True, seed=seed)
+    return UnpaddedDistributedSampler(dataset, get_world_size(), get_rank())
 
 
